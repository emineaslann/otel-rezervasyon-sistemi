									"pm.test(\"Ters tarih reddedildi (400)\", () => pm.response.to.have.status(400));\r",
									"pm.test(\"Anlaşılır mesaj\", () =>\r",
									"    pm.expect(pm.response.json().mesaj).to.include(\"Çıkış tarihi\"));"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "GET",
