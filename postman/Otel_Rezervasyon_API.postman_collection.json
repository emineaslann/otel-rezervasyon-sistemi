                  "pm.test(\"Yeni rezervasyon listede\", () => {\r",
                  "    const rezId = Number(pm.collectionVariables.get(\"rezId\"));\r",
                  "    pm.expect(liste.map(r => r.rezervasyonId)).to.include(rezId);\r",
