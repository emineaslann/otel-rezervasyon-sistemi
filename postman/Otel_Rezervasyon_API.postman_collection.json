{
	"info": {
		"_postman_id": "d9bfe682-54ce-4c0c-ac98-b5e9230cdc56",
		"name": "Otel Rezervasyon API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "40143334"
	},
	"item": [
		{
			"name": "1 - Kimlik Doğrulama",
			"item": [
				{
					"name": "Giriş - Yönetici",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Giriş başarılı (200)\", () => pm.response.to.have.status(200));\r",
									"\r",
									"const cevap = pm.response.json();\r",
									"pm.collectionVariables.set(\"token\", cevap.token);\r",
									"\r",
									"pm.test(\"Rol YONETICI\", () => pm.expect(cevap.kullanici.rol).to.eql(\"YONETICI\"));"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\r\n  \"kullaniciAdi\": \"yonetici\",\r\n  \"sifre\": \"Yonetici123!\"\r\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/giris",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"giris"
							]
						}
					},
					"response": []
				},
				{
					"name": "Ben Kimim",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Token kabul edildi (200)\", () => pm.response.to.have.status(200));\r",
									"pm.test(\"Doğru kullanıcı\", () => pm.expect(pm.response.json().kullaniciAdi).to.eql(\"yonetici\"));"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auth/ben",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"ben"
							]
						}
					},
					"response": []
				},
				{
					"name": "Giriş - Yanlış Şifre",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Yanlış şifre reddedildi (401)\", () => pm.response.to.have.status(401));\r",
									"pm.test(\"Türkçe hata mesajı\", () =>\r",
									"    pm.expect(pm.response.json().mesaj).to.eql(\"Kullanıcı adı veya şifre hatalı.\"));"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\r\n  \"kullaniciAdi\": \"yonetici\",\r\n  \"sifre\": \"yanlis\"\r\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/giris",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"giris"
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
