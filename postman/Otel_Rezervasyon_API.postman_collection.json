							"script": {
								"exec": [
									"pm.test(\"Yanlış şifre reddedildi (401)\", () => pm.response.to.have.status(401));\r",
									"pm.test(\"Türkçe hata mesajı\", () =>\r",
									"    pm.expect(pm.response.json().mesaj).to.eql(\"Kullanıcı adı veya şifre hatalı.\"));"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\r\n  \"kullaniciAdi\": \"yonetici\",\r\n  \"sifre\": \"yanlis\"\r\n}",
