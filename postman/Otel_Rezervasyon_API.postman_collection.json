          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Bugüne göre tarihler\r",
                  "const tarih = (gun) => {\r",
                  "    const d = new Date();\r",
                  "    d.setDate(d.getDate() + gun);\r",
                  "    return d.toISOString().slice(0, 10);\r",
                  "};\r",
                  "const giris = tarih(40), cikis = tarih(43);\r",
                  "pm.collectionVariables.set(\"rezGiris\", giris);\r",
                  "pm.collectionVariables.set(\"rezCikis\", cikis);\r",
                  "\r",
                  "// Önce boş oda ara, ilk bulunan odayı kullan\r",
                  "const adres = pm.collectionVariables.get(\"baseUrl\") +\r",
                  "    `/api/odalar/bos?giris=${giris}&cikis=${cikis}&kisi=2`;\r",
                  "pm.sendRequest(adres, (hata, cevap) => {\r",
                  "    pm.collectionVariables.set(\"rezOdaId\", cevap.json()[0].odaId);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Rezervasyon oluşturuldu (201)\", () => pm.response.to.have.status(201));\r",
                  "\r",
                  "const rez = pm.response.json();\r",
                  "pm.collectionVariables.set(\"rezId\", rez.rezervasyonId);\r",
                  "\r",
                  "pm.test(\"Misafir rezervasyonu onay bekliyor\", () => pm.expect(rez.durum).to.eql(\"BEKLEMEDE\"));\r",
                  "pm.test(\"Fiyat hesaplandı\", () => pm.expect(rez.toplamFiyat).to.be.above(0));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
